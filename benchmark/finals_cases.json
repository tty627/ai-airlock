{
  "schema_version": "finals-cases-v1",
  "provenance": {
    "kind": "synthetic_engineering_acceptance",
    "created_for": "AI Airlock finals evidence-session engineering validation",
    "blind_holdout": false,
    "authors_can_see_labels": true,
    "agent_or_llm_evaluation": false,
    "followup_policy": "scripted preset questions declared in this file before execution; no autonomous model decision",
    "limitations": [
      "These are small synthetic tasks with public labels, not production data or an independently blinded benchmark.",
      "Exact evidence marker retention is not root-cause correctness or task completion.",
      "Sensitive marker absence only measures the listed synthetic values, not general leakage resistance.",
      "Cases include irrelevant error lines to expose failure-signal retrieval bias."
    ]
  },
